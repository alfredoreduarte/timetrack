// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  name              String
  password          String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  defaultHourlyRate Float?
  idleTimeoutSeconds Int? @default(600) @map("idle_timeout_seconds")
  // New users bill AI time at their normal rate; existing users keep theirs.
  aiMultiplier Float? @default(1.0) @map("ai_multiplier")
  // How parallel timers on one project are billed: dedupe | sum
  overlapMode  String @default("dedupe") @map("overlap_mode")
  currency     String @default("USD")
  // Agent timers fed by heartbeats (hooks) pause after this much silence.
  agentIdleTimeoutSeconds Int @default(900) @map("agent_idle_timeout_seconds")
  passwordResetToken    String?
  passwordResetExpiresAt DateTime?

  // Relations
  projects     Project[]
  timeEntries  TimeEntry[]
  tasks        Task[]
  apiKeys      ApiKey[]
  favorites    Favorite[]
  auditEvents  AuditEvent[]
  timers       Timer[]
  timerNotes   TimerNote[]
  shareLinks   ShareLink[]

  @@map("users")
  @@index([email])
  @@index([passwordResetToken])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#3B82F6")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hourlyRate  Float?
  // Repositories that belong to this project: normalized git remotes
  // (github.com/acme/web) or absolute path prefixes. Agent timers started in
  // a matching repo are assigned to this project automatically.
  repoPatterns String[] @default([]) @map("repo_patterns")
  // Billing policy overrides (null = inherit the user's setting).
  overlapMode         String? @map("overlap_mode")
  aiMultiplier        Float?  @map("ai_multiplier")
  // Flat hourly rate for AI-assisted time; overrides rate x multiplier.
  agentHourlyRate     Float?  @map("agent_hourly_rate")
  // Pass agents' API-equivalent token cost through to the client.
  includeAiCosts      Boolean @default(false) @map("include_ai_costs")
  aiCostMarkupPercent Float   @default(0) @map("ai_cost_markup_percent")

  // Relations
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeEntries TimeEntry[]
  favorites   Favorite[]
  timers      Timer[]
  shareLinks  ShareLink[]

  @@map("projects")
  @@index([userId])
  @@index([userId, isActive])
}

model Task {
  id          String    @id @default(cuid())
  name        String
  description String?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hourlyRate  Float?

  // Relations
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  favorites   Favorite[]
  timers      Timer[]

  @@map("tasks")
  @@index([projectId])
  @@index([userId])
  @@index([userId, isCompleted])
}

model TimeEntry {
  id                  String    @id @default(cuid())
  description         String?
  startTime           DateTime
  endTime             DateTime?
  duration            Int?      // Duration in seconds
  isRunning           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  hourlyRateSnapshot  Float?    // Snapshot of hourly rate at time of creation
  createdVia          String    @default("web") @map("created_via")
  isAiGenerated       Boolean   @default(false) @map("is_ai_generated")
  // Why the segment ended: manual | paused | idle | stopped | session_end | import
  stopReason          String?   @map("stop_reason")

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // The pausable timer this entry is a segment of (null for pre-timer entries).
  timerId   String?  @map("timer_id")
  timer     Timer?   @relation(fields: [timerId], references: [id], onDelete: SetNull)

  @@map("time_entries")
  @@index([userId])
  @@index([userId, isRunning])
  @@index([userId, startTime])
  @@index([userId, isAiGenerated])
  @@index([projectId])
  @@index([taskId])
  @@index([timerId])
}

// A unit of work that can be paused and resumed — typically one AI agent
// session (keyed by its sessionKey) or one human task. Each running stretch is
// a TimeEntry segment; a running timer has exactly one running entry.
model Timer {
  id                 String    @id @default(cuid())
  status             String    @default("running") // running | paused | stopped
  description        String?
  // Client-supplied idempotency key, e.g. a Claude Code session_id.
  sessionKey         String?   @map("session_key")
  agent              String? // claude_code | cursor | codex | human | ...
  createdVia         String    @default("web") @map("created_via")
  isAiGenerated      Boolean   @default(false) @map("is_ai_generated")
  cwd                String?
  gitRemote          String?   @map("git_remote") // normalized, credential-free
  gitBranch          String?   @map("git_branch")
  // null = never auto-pause (no reliable heartbeats for this timer)
  idleTimeoutSeconds Int?      @map("idle_timeout_seconds")
  lastActivityAt     DateTime  @default(now()) @map("last_activity_at")
  pauseReason        String?   @map("pause_reason") // manual | idle
  startedAt          DateTime  @default(now()) @map("started_at")
  stoppedAt          DateTime? @map("stopped_at")
  usage              Json? // per-model token counts reported by the agent
  costUsd            Float?    @map("cost_usd")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?  @map("task_id")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  entries   TimeEntry[]
  notes     TimerNote[]

  @@unique([userId, sessionKey])
  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@map("timers")
}

// Work-log lines attached to a timer ("refactored auth middleware").
model TimerNote {
  id        String   @id @default(cuid())
  body      String
  via       String?
  createdAt DateTime @default(now()) @map("created_at")

  timerId String @map("timer_id")
  timer   Timer  @relation(fields: [timerId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([timerId, createdAt])
  @@index([userId, createdAt])
  @@map("timer_notes")
}

model ApiKey {
  id           String    @id @default(cuid())
  name         String
  keyHash      String    @unique @map("key_hash")
  keyPrefix    String    @map("key_prefix")
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  aiByDefault  Boolean   @default(true) @map("ai_by_default")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@index([userId])
  @@index([keyHash])
  @@index([userId, isActive])
}

model Favorite {
  id            String   @id @default(cuid())
  displayOrder  Int      @default(0) @map("display_order")
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId, taskId, description], name: "unique_favorite")
  @@map("favorites")
  @@index([userId])
  @@index([userId, displayOrder])
}
// Append-only record of changes to billable data: who (user, API key, or the
// system), through which client, and what changed. Lets a developer show a
// client exactly how AI agents touched their timesheet.
model AuditEvent {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type") // time_entry | timer | project | ...
  entityId   String   @map("entity_id")
  action     String // create | update | delete | start | pause | resume | stop | ...
  actorType  String   @map("actor_type") // user | api_key | system
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label")
  via        String?
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_events")
  @@index([userId, entityType, entityId])
  @@index([userId, createdAt])
}

// Read-only timesheet link a developer sends to a client. The token is
// shown once; only its SHA-256 hash is stored.
model ShareLink {
  id           String    @id @default(cuid())
  name         String?
  tokenHash    String    @unique @map("token_hash")
  tokenPrefix  String    @map("token_prefix")
  // Fixed range, or a rolling window ending now (e.g. last 30 days).
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  rollingDays  Int?      @map("rolling_days")
  timezone     String    @default("UTC")
  showAmounts  Boolean   @default(true) @map("show_amounts")
  showNotes    Boolean   @default(true) @map("show_notes")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Set when an agent created the link with an API key: the link dies with the key.
  apiKeyId  String?  @map("api_key_id")

  @@index([userId])
  @@map("share_links")
}
