{
  "name": "@timetrack/mcp",
  "version": "2.0.0",
  "description": "TimeTrack MCP server (stdio) \u2014 bridges to the hosted MCP endpoint so AI agents can run parallel timers, edit past entries and build timesheets",
  "type": "module",
  "bin": {
    "timetrack-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
